OPENAI_API_KEY=your_openai_api_key_here
PORT=3001
# Optional: TTS model (default gpt-4o-mini-tts; falls back to tts-1 automatically on error)
# TTS_MODEL=gpt-4o-mini-tts
# Optional: Azure Neural voices (native French voices: Vivienne, Rémy, Denise, Henri).
# Create a "Speech" resource in the Azure portal, then copy Key 1 and its Region here.
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=westeurope
# Optional: point at a persistent volume in production so the TTS cache survives redeploys
# TTS_CACHE_DIR=/data/tts-cache
